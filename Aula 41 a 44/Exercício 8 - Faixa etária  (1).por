programa
{
    funcao inicio()
    {
        inteiro idade
        escreva("Digite sua idade:")
        leia(idade)

        se (idade >= 12 ou idade>= 17)
        {
            escreva("Adolescente")
        }
        senao
        {
            escreva("Não é adolescente")
        }
    }
}//erro está no escreva no começo e no sinal de <