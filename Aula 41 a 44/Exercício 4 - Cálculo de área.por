programa
{
    funcao inicio()
    {
        real largura, altura
        real area

        escreva("Digite a largura:")

        leia(largura)
        escreva("Digite sua altura")
        leia(altura)

        area = largura * altura

        escreva("Área: ", area)

        // o erro está no co,eção largura e altura são real.
        //Outro erro está no dois escrevas que faltaram
    }
}