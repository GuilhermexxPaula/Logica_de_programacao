programa {
  funcao inicio() {
    real numero1, numero2 , numero3, numero4 , numero5 , soma

    escreva("Digite seu primeiro valor:")
    leia(numero1)

     escreva("Digite seu segundo valor:")
    leia(numero2)


     escreva("Digite seu terceiro valor:")
    leia(numero3)


     escreva("Digite seu quarto valor:")
    leia(numero4)


     escreva("Digite seu quinto valor:")
    leia(numero5)

    soma= numero1+ numero2+numero3+numero4+ numero5
    escreva("O valor da soma:", soma)
  }
}
