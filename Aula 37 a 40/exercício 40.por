programa {
  funcao inicio() {
    inteiro n1,n2,n3,n4,n5, contador= 0

    

    escreva("Digite seu Primeiro numero:")
    leia(n1)

     escreva("Digite seu segundo numero:")
    leia(n2)

    escreva("Digite seu Terceiro numero:")
    leia(n3)

    escreva("Digite seu quarto numero:")
    leia(n4)


    escreva("Digite seu quinto numero:")
    leia(n5)


    se (n1>10 e n1<150) contador= contador+1
    

    se (n2>10 e n2<150) contador =contador +1
    

    se (n3>10 e n3<150 ) contador= contador+1
    

    se (n4>10 e n4<150 ) contador= contador+1
    

    se (n5>10 e n5<150 ) contador= contador+1
    

    escreva(contador)




     



    
    
    


    
  }
}
